#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
args=(run --rm --init --user "$(id -u):$(id -g)" -v "$root:/workspace" -w /workspace)

if [[ "${1:-} ${2:-}" == "run dev" ]]; then
  args+=(-p 1420:1420)
  set -- "$@" -- --host 0.0.0.0
fi

exec docker "${args[@]}" -e HOME=/tmp -e CI -e TAURI_ENV_PLATFORM -e TAURI_ENV_DEBUG \
  node:22-bookworm-slim npm "$@"
