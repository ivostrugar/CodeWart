#!/bin/sh
# wart — CodeWart launcher. Opens a project, worktree or folder of repos.
#
#   wart              open the current directory
#   wart PATH...      open one or more repos / worktrees / folders of repos
#   wart review [-m MESSAGE] [--timeout SECS] [PATH]
#                     ask for a review of the worktree at PATH (default: .) in
#                     CodeWart and wait for it; prints the review when it is sent.
#                     PATH may be a folder of repos: one review covers all of them.
#                     Exit 0: review received · 3: --timeout passed, still waiting
#                     (run it again to keep waiting) · 1: error.
#   wart answer REVIEW_ID < answers
#                     send your answers to a review's numbered comments back to
#                     CodeWart, one per comment: "1. solved: …" / "2. answered: …".
#                     REVIEW_ID is on the review's last line.
#   wart agent        guide for coding agents (what CodeWart is for, how to use it)
#
# If CodeWart is already running, projects open as new tabs there.
# @CODEWART_BIN@
set -e

case "$1" in
  -h|--help|-V|--version|review|answer|agent) ;;
  *) [ $# -eq 0 ] && set -- "$PWD" ;;
esac

find_bin() {
  if [ -n "$CODEWART_BIN" ] && [ -x "$CODEWART_BIN" ]; then echo "$CODEWART_BIN"; return; fi
  # Codewart.app: installs from before the rename (matters on case-sensitive volumes).
  for app in "$CODEWART_APP" "/Applications/CodeWart.app" "$HOME/Applications/CodeWart.app" \
    "/Applications/Codewart.app" "$HOME/Applications/Codewart.app"; do
    [ -n "$app" ] && [ -d "$app/Contents/MacOS" ] || continue
    for b in "$app/Contents/MacOS/"*; do
      [ -x "$b" ] && { echo "$b"; return; }
    done
  done
  for b in "$(dirname "$0")/codewart-app" /usr/local/bin/codewart-app /usr/bin/codewart /usr/bin/codewart-app /opt/codewart/codewart; do
    [ -x "$b" ] && { echo "$b"; return; }
  done
}

BIN="$(find_bin)"
if [ -z "$BIN" ]; then
  echo "wart: CodeWart app not found. Install it, or set CODEWART_APP / CODEWART_BIN." >&2
  exit 1
fi

case "$1" in
  -h|--help|-V|--version) exec "$BIN" "$@" ;;
  agent) exec "$BIN" --agent-help ;;
esac

# ---- wart review: request a review and wait for it --------------------------
if [ "$1" = "review" ]; then
  shift
  timeout=0
  msg=""
  dir="$PWD"
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait) ;; # always waits; accepted for clarity
      --timeout) timeout="$2"; shift ;;
      --timeout=*) timeout="${1#*=}" ;;
      -m|--message) msg="$2"; shift ;;
      --message=*) msg="${1#*=}" ;;
      -*) echo "wart review: unknown option $1" >&2; exit 1 ;;
      *) dir="$1" ;;
    esac
    shift
  done
  case "$timeout" in ''|*[!0-9]*) echo "wart review: --timeout needs a number of seconds" >&2; exit 1 ;; esac
  if ! top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
    # A folder of repos (e.g. one feature's worktrees side by side): review them together.
    top="$(cd "$dir" 2>/dev/null && pwd)" || { echo "wart review: $dir does not exist" >&2; exit 1; }
    found=""
    for g in "$top"/*/.git "$top"/*/*/.git; do
      [ -e "$g" ] && { found=1; break; }
    done
    [ -n "$found" ] || {
      echo "wart review: $dir is neither inside a git repository nor a folder of repositories" >&2
      exit 1
    }
  fi
  rdir="${TMPDIR:-/tmp}"
  rdir="${rdir%/}/codewart-reviews"
  mkdir -p "$rdir"
  # One request per worktree, so re-running after --timeout keeps the same request.
  id="$(printf '%s' "$top" | cksum | cut -d' ' -f1)"
  reply="$rdir/review-$id.md"
  echo "$$" > "$reply.waiting"
  trap 'rm -f "$reply.waiting"' EXIT
  trap 'rm -f "$reply.waiting"; exit 130' INT TERM HUP

  if [ ! -f "$reply" ]; then
    CODEWART_CWD="$PWD" nohup "$BIN" "--review-reply=$reply" "--review-message=$msg" "$top" >/dev/null 2>&1 &
    echo "Waiting for your review in CodeWart ($top)…" >&2
  fi

  start=$(date +%s)
  while [ ! -f "$reply" ]; do
    if [ "$timeout" -gt 0 ] && [ $(( $(date +%s) - start )) -ge "$timeout" ]; then
      trap - EXIT # keep the request alive in CodeWart until the next run
      echo "No review yet: the request is still open in CodeWart. Run the same command again to keep waiting."
      exit 3
    fi
    sleep 1
  done
  cat "$reply"
  rm -f "$reply"
  exit 0
fi

# ---- wart answer: answers to a review's comments, back to CodeWart ----------
if [ "$1" = "answer" ]; then
  id="$2"
  case "$id" in
    ''|*[!A-Za-z0-9]*)
      echo "wart answer: give the review id from the review's last line, e.g. wart answer r7k2m9 < answers.md" >&2
      exit 1 ;;
  esac
  rdir="${TMPDIR:-/tmp}"
  rdir="${rdir%/}/codewart-reviews"
  mkdir -p "$rdir"
  file="$rdir/answer-$id-$$.md"
  cat > "$file.tmp"
  if ! grep -q '[^[:space:]]' "$file.tmp"; then
    rm -f "$file.tmp"
    echo "wart answer: no answers on stdin (one line per comment: \"1. solved: …\")" >&2
    exit 1
  fi
  mv "$file.tmp" "$file"
  nohup "$BIN" "--review-answer=$file" >/dev/null 2>&1 &
  # CodeWart deletes the file when it has the answers.
  i=0
  while [ -f "$file" ] && [ $i -lt 40 ]; do sleep 0.25; i=$((i + 1)); done
  if [ -f "$file" ]; then
    rm -f "$file"
    echo "wart answer: CodeWart did not pick up the answers" >&2
    exit 1
  fi
  echo "Answers sent to CodeWart (review $id)."
  exit 0
fi

# Resolve relative paths here so the app gets absolute ones.
for arg in "$@"; do
  case "$arg" in
    /*) set -- "$@" "$arg" ;;
    -*) set -- "$@" "$arg" ;;
    *) set -- "$@" "$(cd "$arg" 2>/dev/null && pwd || echo "$PWD/$arg")" ;;
  esac
  shift
done

CODEWART_CWD="$PWD" nohup "$BIN" "$@" >/dev/null 2>&1 &
