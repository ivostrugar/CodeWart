{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeWart",
  "version": "0.1.4",
  "identifier": "com.bytebrothers.codewart",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeWart",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0E1013",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Review agent-written code",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "\u00a9 Byte Brothers",
    "publisher": "Byte Brothers",
    "license": "MIT",
    "longDescription": "CodeWart is a desktop helper for reviewing code written by coding agents: diffs per commit or worktree, a call-chain diagram of new functions, and review comments sent back to the agent session.",
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0QkQ0MTBCMTc1MUVFNkEKUldScTdsRVhDMEc5TkdyRkFIQzNiNHVPSzEzVW9mTTJHNTk0Tk9vcWN5b2ZkRXpaeWhzMHNqQWsK",
      "endpoints": [
        "https://github.com/ivostrugar/CodeWart/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
